# Supabase (Project Settings > API)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhb...

# Postgres connection string (Project Settings > Database > Connection string > URI)
