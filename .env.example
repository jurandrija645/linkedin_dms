# n8n instanca, bez zadnje kose crte
N8N_BASE_URL=https://n8n.mindaptive.ai

# Lozinka za pristup aplikaciji
APP_PASSWORD=

# Produkcijski URL appa (popuni nakon deploya)
APP_URL=
